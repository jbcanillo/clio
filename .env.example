# Public port of the web container
PORT=4356
TZ=Asia/Manila

# Login (single owner) and encryption key for stored secrets (>= 32 characters)
CLIO_PASSWORD=change-me
SECRET_KEY=change-me-to-a-long-random-string-of-32-chars-or-more

# AI via OpenRouter (the key can also be saved from the Settings screen)
OPENROUTER_API_KEY=
OPENROUTER_MODEL=openai/gpt-4o-mini
# Override only for a proxy or tests
# OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

# Memory layer: plain | basic-memory (see README)
MEMORY_BACKEND=plain
# BASIC_MEMORY_URL=http://basic-memory:8765/mcp

# Web push (generate with: npx web-push generate-vapid-keys)
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:you@example.com

# Sessions and proxies
# SESSION_TTL_HOURS=8
# CORS_ORIGIN=https://clio.example.com
# TRUST_PROXY_HOPS=1

# Backups (scripts/backup.sh)
BACKUP_PASSPHRASE=
